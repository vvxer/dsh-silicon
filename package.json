{
  "name": "dsh-silicon",
  "version": "0.1.0",
  "description": "硅基保留：DeepSeek Harness 的长期记忆插件。原文永久保存、分层概况、相处习惯卡，聊多久都不需要压缩记忆。",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "companion",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvxer/dsh-silicon.git"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.2",
    "@deepseek-ai/schemastery": "~3.18.2",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
